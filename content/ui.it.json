 "@ViewEndings.unlockedText": "Hai sbloccato il finale",
 "@ViewPlayerIntro.introPanelText1": "In quanto fratelli e sorelle di un'influente famiglia di origini est-europee, noi",
 "@ViewPlayerIntro.introPanelText2": "abbiamo ricevuto una parte non trascurabile della tenuta di famiglia. Prima di cominciare, rendiamo questa finzione storica più coinvolgente fornendo i nostri nomi.",
 "@ViewPlayerIntro.introText1": "I nostri più cordiali saluti.",
 "@ViewPlayerIntro.introText2": "Vi auguriamo una piacevole esperienza.",
 "@ViewPlayerIntro.introText3": "Che il vostro nome viva nell'infamia.",
 "@ViewPlayerIntro.introText4": "Non dimenticate di lasciare il segno nel mondo.",
